# Bizora Cloud / Supabase Configuration
# Copy this file to `.env` in the project root (next to package.json) before running
# `npm run dev`, `npm run tauri dev`, or `npm run tauri build`.
# Only use your Supabase project root URL (https://<project-ref>.supabase.co) and public/publishable key.
# NEVER place Supabase service_role keys or secret keys in VITE_* variables or desktop builds.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
